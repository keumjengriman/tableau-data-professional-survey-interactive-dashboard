                                        <run bold='true' fontcolor='#4e79a7' fontname='Segoe UI' fontsize='15'>Happiness Across Age Groups</run>
                                        <run fontcolor='#000000' fontname='Segoe UI'>Æ </run>
                                        <run>Æ&#10;&#10;</run>
                                        <run fontcolor='#000000' fontname='Segoe UI'>This chart compares average job satisfaction scores across age groups. </run>
                                        <run>Æ&#10;</run>
                                        <run fontcolor='#000000' fontname='Segoe UI'>It helps us see whether younger professionals feel differently about</run>
                                        <run>Æ&#10;</run>
                                        <run fontcolor='#000000' fontname='Segoe UI'> their careers than older, more experienced ones.</run>
                                      </formatted-text>
