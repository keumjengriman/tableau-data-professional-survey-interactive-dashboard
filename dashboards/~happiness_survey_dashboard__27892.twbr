                                    <zone fixed-size='532' forceUpdate='true' h='18624' id='115' is-fixed='true' type-v2='text' w='28750' x='417' y='33664'>
                                      <formatted-text>
                                        <run bold='true' fontcolor='#4e79a7' fontname='Segoe UI' fontsize='15'>Who&apos;s switching careers?</run>
                                        <run fontcolor='#4e79a7' fontname='Segoe UI' fontsize='15'>Æ </run>
                                        <run>Æ&#10;&#10;</run>
                                        <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Gender distribution of respondents. A skew signals representation gaps; a balanced split suggests broader inclusivity.</run>
                                      </formatted-text>
