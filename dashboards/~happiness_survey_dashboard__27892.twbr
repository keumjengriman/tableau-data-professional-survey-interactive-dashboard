      <aliases enabled='yes' />
      <column caption='z_HappinessIndex' datatype='real' name='[Calculation_2044869717110784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//computes for 3 happiness questions - learnings, upward mobility, and management &#13;&#10;([Q6 - How Happy are you in your Current Position with the following? (Management)]+[Q6 - How Happy are you in your Current Position with the following? (Upward Mobility)]+[Q6 - How Happy are you in your Current Position with the following? (Learning New Things)])/3' />
      </column>
      <column caption='z_Age_Group' datatype='string' name='[Calculation_2688084250394624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//Computes per age group&#13;&#10;//&lt; 25, then Young &#13;&#10;//&lt;= 35 then Early CAreer &#13;&#10;//&lt;=50, then Mid Career &#13;&#10;// &gt;50, Senior&#13;&#10;&#13;&#10;&#13;&#10;IF [Q10 - Current Age] &lt; 25 THEN &apos;Young&apos;&#13;&#10;ELSEIF [Q10 - Current Age]&lt;= 35 THEN &apos;Early Career&apos;&#13;&#10;ELSEIF [Q10 - Current Age] &lt;=50 THEN &apos;Mid Career&apos;&#13;&#10;ELSE &apos;Senior&apos;&#13;&#10;END' />
      </column>
      <column caption='z_country2' datatype='string' name='[Calculation_2688084275900419]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='//replace &apos;other please specify&apos; value in the Q11 column&#13;&#10;&#13;&#10;REPLACE( [Q11 - Which Country do you live in?],&quot;Other (Please Specify):&quot;, &quot;&quot;)' />
      </column>
