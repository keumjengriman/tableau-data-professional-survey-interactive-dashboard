            <column datatype='string' name='[Q11 - Which Country do you live in?]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[Q6 - How Happy are you in your Current Position with the following? (Learning New Things)]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Q6 - How Happy are you in your Current Position with the following? (Management)]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Q6 - How Happy are you in your Current Position with the following? (Upward Mobility)]' role='measure' type='quantitative' />
            <column datatype='string' name='[Q9 - Male/Female?]' role='dimension' type='nominal' />
